# Copy to .env.local for development. Never commit real values.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Signs the short-lived cookie behind the confirmation page. Any long random string (e.g. 32 random bytes, base64).
CONFIRMATION_COOKIE_SECRET=generate-a-long-random-string

# App settings
APP_TIME_ZONE=America/New_York
EMERGENCY_PHONE_DISPLAY=(000) 000-0000
EMERGENCY_PHONE_TEL=0000000000
AGING_DAYS=3
COMPANY_NAME=Your Company
